[Unit]
Description=Portal backend (noctalia)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.noctalia
ExecStart=@libexecdir@/xdg-desktop-portal-noctalia
Restart=on-failure
RestartSec=5s
